{
  "compilerOptions": {
    "composite": true,
    "jsx": "react",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "noEmit": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts"
  ]
}
